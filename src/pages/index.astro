---
import SchemaConverter from "../components/Converter";
import '../styles/styles.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>JSON to Zod Schema Converter</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-900">
    <main class="min-h-screen text-white flex flex-col items-center p-4 sm:p-8">
      <h1 class="text-3xl sm:text-4xl font-bold mb-6 text-center">
        JSON to Zod Schema Converter
      </h1>
      <div class="w-full">
        <SchemaConverter client:load />
      </div>
    </main>
  </body>
</html>
